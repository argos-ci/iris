{
  "name": "@argos-ci/iris",
  "version": "0.1.0-beta.0",
  "description": "Single-pass screenshot comparison for Node.js: multi-threshold pixel diff with anti-aliasing detection, diff fingerprinting and layout-shift detection.",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/argos-ci/iris.git"
  },
  "license": "MIT",
  "keywords": [
    "image-diff",
    "visual-regression",
    "screenshot",
    "fingerprint",
    "napi-rs",
    "rust"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "iris",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "bench": "node scripts/bench.mjs",
    "format": "cargo fmt --all && prettier . -w",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "pnpm test:rust && pnpm test:node",
    "test:node": "vitest run",
    "test:rust": "ODIFF_BIN=$(node scripts/odiff-path.mjs) REQUIRE_ODIFF=1 cargo test -p iris",
    "version": "napi version"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@argos-ci/mask-fingerprint": "0.1.3",
    "@napi-rs/cli": "^3.2.0",
    "@types/node": "^24.0.0",
    "odiff-bin": "4.5.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.0",
    "tinybench": "^5.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
